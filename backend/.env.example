PORT=5000
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# AES-256 encryption key (exactly 32 characters) for encrypting stored Meta tokens
ENCRYPTION_KEY="auto-ads-care-secret-key-32chr!"

# Meta Marketing API Configuration
# Register an app at https://developers.facebook.com/apps/
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v22.0
META_REDIRECT_URI=http://localhost:5000/api/auth/meta/callback

# Default Admin User
DEFAULT_USER_EMAIL=admin@autoadscare.io

# Scheduler interval in cron syntax (defaults to every 1 minute)
SCHEDULER_CRON=*/1 * * * *

# Emergency Stop safety kill-switch (true to pause all automation engine actions)
EMERGENCY_STOP=false

# Allow Mock Mode when no real Meta credentials exist
ENABLE_MOCK_FALLBACK=true
