# Application Ports
PORT=5000
NODE_ENV=development

# Database (Default zero-config SQLite, can be swapped with PostgreSQL: postgresql://user:pass@localhost:5432/autoads)
DATABASE_URL="file:./dev.db"

# AES-256 Encryption Key for Stored Meta Access Tokens (Must be at least 32 characters)
ENCRYPTION_KEY="auto-ads-care-secret-key-32chr!"

# Meta Marketing API App Credentials (From https://developers.facebook.com/apps/)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_API_VERSION=v22.0
META_REDIRECT_URI=http://localhost:5000/api/auth/meta/callback

# Default User
DEFAULT_USER_EMAIL=admin@autoadscare.io

# Background Care Scheduler (Cron syntax, default: check every 1 minute)
SCHEDULER_CRON=*/1 * * * *

# Emergency Stop safety switch (Set to true to freeze all automated write API actions)
EMERGENCY_STOP=false

# Enable Mock Mode fallback when real Meta credentials are not provided
ENABLE_MOCK_FALLBACK=true
